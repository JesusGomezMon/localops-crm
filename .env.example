# Copy to .env for local development.
# NOTHING in this file is a real credential.

DATABASE_URL="file:./dev.db"

# Auth.js session signing. Generate a real one with: npx auth secret
AUTH_SECRET="dev-only-secret-change-me"
AUTH_URL="http://localhost:3000"

# Staff panel password, installed by `pnpm db:seed`.
# Leave unset in development and it defaults to "admin123".
# Production REFUSES TO START unless this is set to something else — see auth.ts.
# ADMIN_PASSWORD="change-me-before-deploying"

# Public booking rate limit (per IP, fixed window).
BOOKING_RATE_LIMIT="5"
BOOKING_RATE_WINDOW_MS="60000"

# Stripe Checkout. Test/sandbox key only; never commit a live key.
# Without it the app records bookings and reports payment as pending.
# STRIPE_SECRET_KEY="sk_test_..."
